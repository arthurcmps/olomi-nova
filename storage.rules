rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.admin == true;
    }

    // Imagens públicas do catálogo.
    match /products/{productId}/{fileName} {
      allow read: if true;

      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }

    // Qualquer outro caminho fica bloqueado.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
